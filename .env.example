DATABASE_URL="postgresql://life_tasks:life_tasks@localhost:5432/life_tasks?schema=public"
PORT=3000
NODE_ENV=development

# Auth0 — required. Every /api/tasks and /api/boards route verifies the caller's
# access token against the tenant JWKS. AUTH0_DOMAIN is the tenant domain (no
# scheme); AUTH0_AUDIENCE is the identifier of the Auth0 API for this backend.
AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_AUDIENCE=https://api.life-tasks

# Web Push — optional. Without the VAPID keys push notifications are simply off.
# Generate a pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# AI agents (MCP) — optional. Without MCP_PUBLIC_URL the /api/mcp endpoint answers 503.
# MCP_PUBLIC_URL is the exact public URL of POST /api/mcp (what users paste into Claude etc.).
# The API is its own OAuth server for assistants (/api/oauth/*); Auth0 only signs people in.
MCP_PUBLIC_URL=
# A Regular Web Application in Auth0 used only for that sign-in. Its Allowed Callback URL is
# <MCP_PUBLIC_URL origin>/api/oauth/callback (see deploy/auth0/README.md).
AUTH0_LOGIN_CLIENT_ID=
AUTH0_LOGIN_CLIENT_SECRET=
# Web app origin, where people approve an assistant. Defaults to the MCP_PUBLIC_URL origin.
APP_URL=
# Proxies in front of the API (Cloudflare + Caddy = 2), so rate limits see the visitor's IP.
TRUST_PROXY_HOPS=2

# Task from a photo — optional. Without GEMINI_API_KEY POST /api/tasks/from-photo answers 503.
# The free tier lets Google use the content to improve its products — don't point real user photos at it.
# PHOTO_IMPORT_STUB=1 returns a canned result without calling Gemini (for FE development).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Tried after GEMINI_MODEL answered 503/429 twice.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
PHOTO_IMPORT_STUB=

# Avatars and board covers — optional. Without these the upload endpoints answer 503.
# A Cloudflare R2 bucket made public through a custom domain (the web app builds image URLs from that domain
# + the stored key). R2_ACCESS_KEY_ID/SECRET are an R2 API token with Object Read & Write on the bucket.
# The bucket's CORS policy must allow PUT with Content-Type from the web app origin.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
