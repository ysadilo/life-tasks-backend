DATABASE_URL="postgresql://life_tasks:life_tasks@localhost:5432/life_tasks?schema=public"
PORT=3000
NODE_ENV=development

# Auth0 — required. Every /api/tasks and /api/boards route verifies the caller's
# access token against the tenant JWKS. AUTH0_DOMAIN is the tenant domain (no
# scheme); AUTH0_AUDIENCE is the identifier of the Auth0 API for this backend.
AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_AUDIENCE=https://api.life-tasks

# Web Push — optional. Without the VAPID keys push notifications are simply off.
# Generate a pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# AI agents (MCP) — optional. Without MCP_PUBLIC_URL the /api/mcp endpoint answers 503.
# MCP_PUBLIC_URL is the exact public URL of POST /api/mcp (what users paste into Claude etc.).
# It is also the audience of the OAuth access tokens, so in Auth0 create a second API whose
# Identifier is this same URL, enable Dynamic Client Registration (Tenant Settings > Advanced),
# set the tenant's default audience / resource-parameter compatibility so the `resource`
# MCP clients send maps to that API, and promote the Google/Username connection to a
# domain-level connection so dynamically registered clients can sign users in.
MCP_PUBLIC_URL=
