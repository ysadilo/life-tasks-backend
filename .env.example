DATABASE_URL="postgresql://life_tasks:life_tasks@localhost:5432/life_tasks?schema=public"
PORT=3000
NODE_ENV=development

# Auth0 — required. Every /api/tasks and /api/boards route verifies the caller's
# access token against the tenant JWKS. AUTH0_DOMAIN is the tenant domain (no
# scheme); AUTH0_AUDIENCE is the identifier of the Auth0 API for this backend.
AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_AUDIENCE=https://api.life-tasks

# Web Push — optional. Without the VAPID keys push notifications are simply off.
# Generate a pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
