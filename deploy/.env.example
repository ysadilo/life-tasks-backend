# Copy to deploy/.env on the Pi. Never commit the real file.
POSTGRES_PASSWORD=change-me
AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_AUDIENCE=https://api.life-tasks
# Feedback -> GitHub issues. Token needs Issues: read/write on that repo only.
GITHUB_TOKEN=
GITHUB_FEEDBACK_REPO=owner/repo

# Web Push (optional): npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# AI agents (MCP) — optional. Without MCP_PUBLIC_URL the /api/mcp endpoint answers 503.
# MCP_PUBLIC_URL is the exact public URL of POST /api/mcp (what users paste into Claude etc.).
# The API is its own OAuth server for assistants (/api/oauth/*); Auth0 only signs people in.
MCP_PUBLIC_URL=
# A Regular Web Application in Auth0 used only for that sign-in. Its Allowed Callback URL is
# <MCP_PUBLIC_URL origin>/api/oauth/callback (see deploy/auth0/README.md).
AUTH0_LOGIN_CLIENT_ID=
AUTH0_LOGIN_CLIENT_SECRET=
# Web app origin, where people approve an assistant. Defaults to the MCP_PUBLIC_URL origin.
APP_URL=
# Proxies in front of the API (Cloudflare + Caddy = 2), so rate limits see the visitor's IP.
TRUST_PROXY_HOPS=2
