generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  backlog
  today
  needs_triage
  done
}

// What a connected AI agent (MCP client) is allowed to do; managed in Settings > AI agents.
enum AgentPermission {
  read
  add
  edit
  done
  triage
  delete
}

enum AgentActionKind {
  read
  added
  edited
  moved
  done
  triaged
  deleted
}

enum BoardRole {
  owner
  member
}

enum ActivityType {
  added
  finished
  assigned
}

enum Priority {
  P1
  P2
  P3
  P4
}

enum Energy {
  low
  medium
  high
}

enum Feeling {
  drained
  heavy
  neutral
  good
  great
}

enum TaskSort {
  priority
  dueDate
  effort
  manual
}

enum TaskGroupBy {
  area
  priority
  energy
  effort
  none
}

enum Recurrence {
  daily
  weekdays
  weekly
  biweekly
  monthly
  custom
}

// Unit of a `custom` recurrence ("every N days / weeks / months").
enum RecurrenceUnit {
  day
  week
  month
}

// Populated from Clerk on first sign-in; Clerk owns credentials.
model User {
  id        String   @id
  email     String   @unique
  createdAt DateTime @default(now())

  ownedBoards       Board[]            @relation("BoardOwner")
  invitesSent       BoardInvite[]
  activityDone      Activity[]         @relation("ActivityActor")
  activityAbout     Activity[]         @relation("ActivityTarget")
  memberships       BoardMember[]
  assignedTasks     Task[]             @relation("TaskAssignee")
  preferences       UserPreference?
  pushSubscriptions PushSubscription[]
  boardMutes        BoardMute[]
  agentConnections  AgentConnection[]
}

// How the user last chose to sort Today and group the Backlog; a missing row means defaults.
model UserPreference {
  userId         String      @id
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  todaySortBy    TaskSort    @default(priority)
  backlogGroupBy TaskGroupBy @default(area)
  updatedAt      DateTime    @updatedAt
}

model Board {
  id      String @id @default(cuid())
  name    String
  ownerId String
  owner   User   @relation("BoardOwner", fields: [ownerId], references: [id])

  // Shared boards list their members and take invites; personal ones stay private.
  shared     Boolean @default(false)
  // Anyone signed in who has this code can join as a member; null = link disabled.
  inviteCode String? @unique

  members   BoardMember[]
  invites   BoardInvite[]
  activity  Activity[]
  mutes     BoardMute[]
  tasks     Task[]
  lifeAreas LifeArea[]

  createdAt DateTime @default(now())
}

// Ordered per-board list, capped at 10 by LifeAreasService. `order` also picks
// the display colour client-side (palette slot = order % 10) and the fallback
// area a deleted area's tasks are reassigned to (lowest remaining order).
model LifeArea {
  id      String @id @default(cuid())
  boardId String
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)

  name  String
  order Int

  tasks Task[]

  createdAt DateTime @default(now())

  @@unique([boardId, name])
  @@index([boardId, order])
}

model BoardMember {
  boardId String
  userId  String
  role    BoardRole @default(member)

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([boardId, userId])
}

// A browser/device that agreed to Web Push; one user can have several. Dropped when the push service says it's gone.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// The user turned push notifications off for this board; no row = notifications on.
model BoardMute {
  boardId String
  userId  String
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([boardId, userId])
}

// Feed of what members did on a shared board. The title is a snapshot so entries
// outlive the task; `targetUserId` is who a task was assigned to (null = unassigned).
model Activity {
  id           String       @id @default(cuid())
  boardId      String
  board        Board        @relation(fields: [boardId], references: [id], onDelete: Cascade)
  actorId      String
  actor        User         @relation("ActivityActor", fields: [actorId], references: [id], onDelete: Cascade)
  type         ActivityType
  taskTitle    String
  targetUserId String?
  target       User?        @relation("ActivityTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  createdAt    DateTime     @default(now())

  @@index([boardId, createdAt])
}

// Pending invite by email (the invitee may not have signed in yet). Accepting
// it turns it into a BoardMember row and deletes it.
model BoardInvite {
  id        String   @id @default(cuid())
  boardId   String
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  email     String
  invitedBy String
  inviter   User     @relation(fields: [invitedBy], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([boardId, email])
  @@index([email])
}

model Task {
  id      String @id @default(cuid())
  boardId String
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)

  title            String
  description      String?
  dueDate          DateTime?
  status           TaskStatus @default(backlog)
  todayDate        DateTime?
  completedAt      DateTime?
  areaId           String?
  area             LifeArea?  @relation(fields: [areaId], references: [id], onDelete: SetNull)
  priority         Priority?
  energy           Energy?
  estimatedMinutes Int?
  // Optional "Done + reflect" check-in, captured when the task is finished.
  // Name of the AI agent that created / completed the task, when one did.
  createdVia       String?
  completedVia     String?
  feeling          Feeling?
  actualMinutes    Int?

  // A recurring task is a single "series" row. Occurrences are virtual — derived
  // from the rule between dueDate (the first occurrence) and recurrenceEndDate —
  // and never materialized as their own rows. completedDates records which
  // occurrence days have been ticked off.
  // ponytail: completedDates as an array grows ~365/yr for a daily task; move to
  // a TaskOccurrence table if that ever matters.
  recurrence                   Recurrence?
  recurrenceInterval           Int?
  recurrenceUnit               RecurrenceUnit?
  recurrenceEndDate            DateTime?
  completedDates               DateTime[]      @default([])
  // Occurrence day(s) missed (past, unresolved, no occurrence today) surfaced in
  // Triage. In practice holds at most one entry — a new miss replaces the old.
  missedDates                  DateTime[]      @default([])
  // Occurrence day(s) forced onto Today outside the normal cadence, e.g. via the
  // Triage "add to today" resolution for a missed occurrence.
  extraTodayDates              DateTime[]      @default([])
  // The most recent missed occurrence already resolved (any action — done,
  // dismissed, or added to today). Stops detection from re-flagging the same
  // day right after it's cleared from missedDates.
  lastResolvedMissedOccurrence DateTime?

  assigneeId String?
  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([boardId, status])
  @@index([boardId, dueDate])
}

// One OAuth-connected AI agent (an MCP client) per user. Created on its first
// call with safe defaults; the user widens or narrows it in Settings.
model AgentConnection {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  // OAuth client id from the access token (`azp`), so each agent app is its own connection.
  clientId    String
  name        String
  permissions AgentPermission[] @default([read, add])
  // Boards the agent may touch; membership is still re-checked on every call.
  boardIds    String[]          @default([])
  lastUsedAt  DateTime?
  // A revoked connection stays blocked even though its OAuth token is still valid until it expires.
  revokedAt   DateTime?
  createdAt   DateTime          @default(now())

  actions AgentAction[]

  @@unique([userId, clientId])
}

// What an agent did, newest first in the "Agent activity" feed. Titles are
// snapshots so entries outlive the task.
model AgentAction {
  id           String          @id @default(cuid())
  connectionId String
  connection   AgentConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  kind         AgentActionKind
  boardId      String?
  taskId       String?
  taskTitle    String?
  // Free text shown after the title, e.g. "to Backlog · P2 · 30m · Social".
  detail       String?
  createdAt    DateTime        @default(now())

  @@index([connectionId, createdAt])
}
