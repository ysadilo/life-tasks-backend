generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  backlog
  today
  needs_triage
  done
}

enum BoardRole {
  owner
  member
}

enum Priority {
  P1
  P2
  P3
  P4
}

enum Energy {
  low
  medium
  high
}

enum Recurrence {
  daily
  weekdays
  weekly
  biweekly
  monthly
}

// Populated from Clerk on first sign-in; Clerk owns credentials.
model User {
  id        String   @id
  email     String   @unique
  createdAt DateTime @default(now())

  ownedBoards   Board[]       @relation("BoardOwner")
  memberships   BoardMember[]
  assignedTasks Task[]        @relation("TaskAssignee")
}

model Board {
  id      String @id @default(cuid())
  name    String
  ownerId String
  owner   User   @relation("BoardOwner", fields: [ownerId], references: [id])

  members   BoardMember[]
  tasks Task[]
  lifeAreas LifeArea[]

  createdAt DateTime @default(now())
}

// Ordered per-board list, capped at 10 by LifeAreasService. `order` also picks
// the display colour client-side (palette slot = order % 10) and the fallback
// area a deleted area's tasks are reassigned to (lowest remaining order).
model LifeArea {
  id      String @id @default(cuid())
  boardId String
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)

  name  String
  order Int

  tasks Task[]

  createdAt DateTime @default(now())

  @@unique([boardId, name])
  @@index([boardId, order])
}

model BoardMember {
  boardId String
  userId  String
  role    BoardRole @default(member)

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([boardId, userId])
}

model Task {
  id          String     @id @default(cuid())
  boardId     String
  board       Board      @relation(fields: [boardId], references: [id], onDelete: Cascade)

  title       String
  description String?
  dueDate     DateTime?
  status      TaskStatus @default(backlog)
  todayDate   DateTime?
  completedAt DateTime?
  areaId      String?
  area        LifeArea?  @relation(fields: [areaId], references: [id], onDelete: SetNull)
  priority    Priority?
  energy      Energy?
  estimatedMinutes Int?

  // A recurring task is a single "series" row. Occurrences are virtual — derived
  // from the rule between dueDate (the first occurrence) and recurrenceEndDate —
  // and never materialized as their own rows. completedDates records which
  // occurrence days have been ticked off.
  // ponytail: completedDates as an array grows ~365/yr for a daily task; move to
  // a TaskOccurrence table if that ever matters.
  recurrence        Recurrence?
  recurrenceEndDate DateTime?
  completedDates    DateTime[] @default([])
  // Occurrence day(s) missed (past, unresolved, no occurrence today) surfaced in
  // Triage. In practice holds at most one entry — a new miss replaces the old.
  missedDates       DateTime[] @default([])
  // Occurrence day(s) forced onto Today outside the normal cadence, e.g. via the
  // Triage "add to today" resolution for a missed occurrence.
  extraTodayDates   DateTime[] @default([])
  // The most recent missed occurrence already resolved (any action — done,
  // dismissed, or added to today). Stops detection from re-flagging the same
  // day right after it's cleared from missedDates.
  lastResolvedMissedOccurrence DateTime?

  assigneeId  String?
  assignee    User?      @relation("TaskAssignee", fields: [assigneeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([boardId, status])
  @@index([boardId, dueDate])
}
